+  private isCameraAiming() {
+    return this.pointerLocked || this.firing || this.keys.has("fire") || this.weaving || this.inputLabel === "CONTROLE" || this.inputLabel === "TOQUE";
+  }
+
+  private belongsTo(object: THREE.Object3D, root: THREE.Object3D) {
+    let current: THREE.Object3D | null = object;
+    while (current) {
+      if (current === root) return true;
+      current = current.parent;
+    }
+    return false;
+  }
+
+  private isAimRayIgnored(object: THREE.Object3D) {
+    if (!object.visible) return true;
+    let current: THREE.Object3D | null = object.parent;
+    while (current) {
+      if (!current.visible) return true;
+      current = current.parent;
+    }
+    if (
+      this.belongsTo(object, this.player) ||
+      this.belongsTo(object, this.nima) ||
+      this.belongsTo(object, this.echoGhost) ||
+      this.belongsTo(object, this.weaveField)
+    ) return true;
+    if (object === this.cloudLayer || object === this.sunDisc || object === this.rain) return true;
+    if (object instanceof THREE.Points || object instanceof THREE.Line || object instanceof THREE.LineSegments || object instanceof THREE.Sprite) return true;
+    const kind = String(object.userData.kind ?? "");
+    if (["bolt", "stars", "pathMarker", "shard"].includes(kind)) return true;
+    if (object instanceof THREE.Mesh) {
+      const materials = Array.isArray(object.material) ? object.material : [object.material];
+      if (materials.some((material) => material.side === THREE.BackSide)) return true;
+    }
+    return false;
+  }
+
+  private raycastAimPoint(origin: THREE.Vector3, direction: THREE.Vector3, far = 140) {
+    this.aimRaycaster.near = 0.08;
+    this.aimRaycaster.far = far;
+    this.aimRaycaster.set(origin, direction);
+    const intersections = this.aimRaycaster.intersectObject(this.world, true);
+    const hit = intersections.find((intersection) => !this.isAimRayIgnored(intersection.object));
+    return hit?.point.clone() ?? origin.clone().addScaledVector(direction, far);
+  }
+
