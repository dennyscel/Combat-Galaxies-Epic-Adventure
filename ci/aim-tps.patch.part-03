 });
+
+
+test("regressão TPS: câmera mira para a frente e mantém KAI-R fora do centro", () => {
+  const visual = between("  private visualUpdate(delta: number)", "  private updateNodes(delta: number)");
+  assert.match(visual, /const viewDirection = new THREE\.Vector3/);
+  assert.match(visual, /desiredCamera\.clone\(\)\.addScaledVector\(viewDirection, 140\)/);
+  assert.match(visual, /this\.camera\.position\.clone\(\)\.addScaledVector\(gameplayViewDirection, 140\)/);
+  assert.match(visual, /shoulderOffset = THREE\.MathUtils\.lerp/);
+  assert.doesNotMatch(visual, /this\.camera\.lookAt\(cameraTarget\)/);
+});
+
+test("regressão TPS: corpo acompanha yaw da câmera mesmo parado em modo de mira", () => {
+  const fixed = between("  private fixedUpdate(delta: number)", "  private visualUpdate(delta: number)");
+  assert.match(fixed, /const aiming = this\.isCameraAiming\(\)/);
+  assert.match(fixed, /analogMagnitude > 0\.03 \|\| aiming/);
+  assert.match(fixed, /aiming\s*\? this\.yaw/);
+});
+
+test("regressão TPS: tiro usa raio da câmera e obstrução a partir do cano", () => {
+  const fire = between("  fire()", "  // Pre-build a shared-material");
+  assert.match(fire, /this\.raycastAimPoint\(camPos, rayDir, 140\)/);
+  assert.match(fire, /this\.raycastAimPoint\(muzzle, boltDir, targetDistance\)/);
+  assert.match(fire, /bolt\.travelLeft = Math\.min\(128/);
+  assert.match(fire, /addScaledVector\(playerRight, 0\.34\)/);
+});
