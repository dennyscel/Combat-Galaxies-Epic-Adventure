+  private qaControlPose(source: "mouse" | "keyboard" | "gamepad" | "pointer", active: boolean, frames = 45) {
+    if (source === "mouse") this.mouseFiring = active;
+    if (source === "gamepad") this.gamepadFiring = active;
+    if (source === "keyboard") {
+      if (active) this.keys.add("fire");
+      else this.keys.delete("fire");
+    }
+    if (source === "pointer") this.pointerLocked = active;
+    this.syncFiringState();
+    for (let index = 0; index < Math.max(1, frames); index += 1) this.visualUpdate(1 / 60);
+    return this.runtimeSnapshot();
+  }
+
+  private qaLocomotionProbe(speed = CHARACTER_MOTOR.walkSpeed, frames = 120) {
+    this.setGameplayEnabled(true);
+    this.driving = false;
+    this.player.visible = true;
+    this.player.rotation.y = 0;
+    this.grounded = true;
+    this.velocity.set(0, 0, -Math.max(0.2, speed));
+    this.locomotionState = speed > CHARACTER_MOTOR.runSpeed ? "sprint" : speed > CHARACTER_MOTOR.walkSpeed + 0.45 ? "run" : "walk";
+    for (let index = 0; index < Math.max(1, frames); index += 1) {
+      this.player.position.z -= speed / 60;
+      this.player.position.y = this.terrainHeight(this.player.position.x, this.player.position.z) + 0.011;
+      this.visualUpdate(1 / 60);
+    }
+    const snapshot = this.runtimeSnapshot();
+    this.velocity.set(0, 0, 0);
+    return snapshot;
+  }
+
+  private qaVehicleProbe(frames = 150) {
+    const car = this.vehicle;
+    if (!car) throw new Error("fixture sem veículo");
+    this.setGameplayEnabled(true);
+    this.driving = true;
+    this.player.visible = false;
+    this.vehicleSpeed = 0;
+    this.vehicleSteerAngle = 0;
+    for (let index = 0; index < Math.max(1, frames); index += 1) {
+      const steering = index < frames * 0.65 ? 0.55 : 0;
+      this.updateVehicle(1 / 60, index < frames * 0.8 ? 0.72 : 0, steering);
+    }
+    return this.runtimeSnapshot();
+  }
+
