+  private settleVehicleOnTerrain(
+    car: THREE.Group,
+    yaw: number,
+    speed: number,
+    steering: number,
+    delta: number,
+  ) {
+    const wheels = car.children.filter((child) => Boolean(child.userData.wheelPivot));
+    if (!wheels.length) {
+      car.position.y = THREE.MathUtils.damp(car.position.y, this.terrainHeight(car.position.x, car.position.z) + 0.02, 12, delta);
+      car.rotation.y = yaw;
+      return;
+    }
+
+    const cos = Math.cos(yaw);
+    const sin = Math.sin(yaw);
+    const contacts = wheels.map((wheel) => {
+      const localX = wheel.position.x;
+      const localZ = wheel.position.z;
+      const worldX = car.position.x + cos * localX + sin * localZ;
+      const worldZ = car.position.z - sin * localX + cos * localZ;
+      return {
+        wheel,
+        ground: this.terrainHeight(worldX, worldZ),
+        localX,
+        localZ,
+      };
+    });
+    const average = contacts.reduce((sum, contact) => sum + contact.ground, 0) / contacts.length;
+    const front = contacts.filter((contact) => contact.localZ < 0);
+    const rear = contacts.filter((contact) => contact.localZ >= 0);
+    const left = contacts.filter((contact) => contact.localX < 0);
+    const right = contacts.filter((contact) => contact.localX >= 0);
+    const mean = (items: typeof contacts) => items.reduce((sum, contact) => sum + contact.ground, 0) / Math.max(1, items.length);
+    const localXValues = contacts.map((contact) => contact.localX);
+    const localZValues = contacts.map((contact) => contact.localZ);
+    const wheelBase = Math.max(0.8, Math.max(...localZValues) - Math.min(...localZValues));
+    const trackWidth = Math.max(0.8, Math.max(...localXValues) - Math.min(...localXValues));
+    const targetPitch = THREE.MathUtils.clamp(Math.atan2(mean(rear) - mean(front), wheelBase), -0.42, 0.42);
+    const targetRoll = THREE.MathUtils.clamp(Math.atan2(mean(left) - mean(right), trackWidth), -0.38, 0.38);
+
+    car.position.y = THREE.MathUtils.damp(car.position.y, average + 0.025, 14, delta);
+    car.rotation.y = yaw;
+    car.rotation.x = THREE.MathUtils.damp(car.rotation.x, targetPitch, 10, delta);
+    car.rotation.z = THREE.MathUtils.damp(car.rotation.z, targetRoll - steering * 0.035, 10, delta);
+
+    for (const contact of contacts) {
+      const wheel = contact.wheel;
+      const restY = Number(wheel.userData.restY ?? wheel.position.y);
+      const radius = Math.max(0.2, Number(wheel.userData.radius ?? 0.5));
+      const suspension = THREE.MathUtils.clamp((contact.ground - average) * 0.72, -0.18, 0.18);
+      wheel.position.y = THREE.MathUtils.damp(wheel.position.y, restY + suspension, 18, delta);
+      wheel.rotation.y = THREE.MathUtils.damp(
+        wheel.rotation.y,
+        wheel.userData.frontWheel ? steering * 0.46 : 0,
+        14,
+        delta,
+      );
+      const tire = wheel.children[0];
+      if (tire) tire.rotation.x += (speed * delta) / radius;
+    }
+  }
